                <Frames>
					<Button name="$parentTab1" inherits="OptionsFrameTabButtonTemplate" hidden="true" text="TUTORIAL_TITLE19">
					<!-- button is hidden until more tabs are added -->
						<Anchors>
							<Anchor point="TOPLEFT">
								<Offset x="22" y="2" />
							</Anchor>
						</Anchors>
						<Scripts>
							<OnLoad>
								-- Forever: retail-style PanelTemplates expects fields on the tab object.
								-- The legacy OptionsFrameTabButtonTemplate only creates named regions.
								local name = self:GetName()
								local regions = { Text = "Text", Left = "Left", Middle = "Middle", Right = "Right",
									LeftActive = "LeftDisabled", MiddleActive = "MiddleDisabled", RightActive = "RightDisabled" }
								for key, suffix in pairs(regions) do
									if self[key] == nil then
										self[key] = _G[name .. suffix]
									end
								end
								PanelTemplates_TabResize(self, 0)
							</OnLoad>
							<OnClick>
								PanelTemplates_SetTab(self:GetParent(), 1)
								VoidMarkStats:UpdateView()
								VoidMarkStats:Recalulate()
								PlaySound(SOUNDKIT.IG_CHARACTER_INFO_TAB)
							</OnClick>
						</Scripts>
                    </Button>
